# =============================================================================
# Run mode
# =============================================================================
# "dry-run" (default): decisions and would-be orders are computed and logged
# normally, but size_order always returns executeOrder=false regardless of
# the strategy's verdict (the calling session must still skip its own
# place_order call in this mode — this flag doesn't stop that call itself).
# This is how the MCP wiring and the strategy get validated against real
# market data without risking capital. Only flip to "live" after the staged
# rollout in test/manual-checklist.md is complete.
MODE=dry-run

# =============================================================================
# HTTP transport for the decision-engine MCP server (src/mcp/server.ts)
# =============================================================================
# The persistent Claude session calling this server needs a stable,
# always-reachable URL — see README "Deployment" for why this can't be a
# stdio-only local server the way salesforce-gantt-agent's is.
MCP_HTTP_PORT=8787
# Shared secret the calling session must present (Authorization: Bearer ...).
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# =============================================================================
# Persisted state (safety/halt flag, PDT trade log, learning weights)
# =============================================================================
STATE_DIR=./state
AUDIT_LOG_DIR=./runs

# =============================================================================
# Risk limits (see src/config/riskLimits.ts for the full set incl. non-.env
# constants; these are the ones most likely to need tuning per account)
# =============================================================================
DAILY_LOSS_HALT_PCT=0.10
MARGIN_UTILIZATION_CAP=0.8
MARGIN_ENABLED=true
PDT_EQUITY_THRESHOLD_USD=25000

# =============================================================================
# Market-trend + news sentiment providers (src/sentiment)
# =============================================================================
# Finnhub — financial/company-specific headlines. Free tier: finnhub.io/register
FINNHUB_API_KEY=

# NewsAPI.org — world/political headlines. Free tier: newsapi.org/register
# NOTE: NewsAPI's free Developer plan disallows production/commercial use —
# this needs a paid plan (or a provider swap) before MODE=live. See README.
NEWSAPI_KEY=

# Benzinga — real-time stock news API (paid). benzinga.com/apis
BENZINGA_API_KEY=

# CoinGecko — crypto market data (BTC dominance, trending coins). Optional:
# the free-tier endpoints used here work without a key; a demo key just
# raises the rate limit. www.coingecko.com/en/api
COINGECKO_API_KEY=

# =============================================================================
# X (Twitter) — macro/world news (src/sentiment/providers/xMacroNews.ts) AND
# per-symbol ticker chatter (src/social/providers/xTickerChatter.ts)
# =============================================================================
# Requires the paid Basic API tier or above — the free tier's read limits
# are too low for search at trading cadence. developer.x.com
X_BEARER_TOKEN=

# =============================================================================
# LLM for sentiment reasoning + learning-reflection rationale
# =============================================================================
# Defaults to this monorepo's own freellmapi gateway (OpenAI-compatible).
# Point LLM_GATEWAY_URL at a direct provider instead if its free-tier
# reliability proves insufficient for this decision path in practice.
LLM_GATEWAY_URL=http://localhost:3000/v1
LLM_GATEWAY_API_KEY=
SENTIMENT_MODEL=gpt-4o-mini
