# =============================================================================
# robinhood-trading-agent — DEPLOYMENT .env template (decision-engine server)
# -----------------------------------------------------------------------------
# Copy to `.env` on the deploy host and fill in the marked values:
#   cp .env.production.example .env
# `.env` is gitignored — never commit real secrets. This template is
# deployment-oriented (Docker volume paths, host networking, staged rollout);
# see `.env.example` for the exhaustive per-variable reference.
#
# Every line marked `# >>> REQUIRED BEFORE MODE=live` must be resolved before
# flipping to live. This server never touches Robinhood — the RobinHood_Trade
# connector lives in the separate persistent Claude session (see README).
# =============================================================================

# -----------------------------------------------------------------------------
# Run mode — START IN DRY-RUN. Do not jump to live (README "Staged rollout" +
# test/manual-checklist.md). In dry-run, size_order always returns
# executeOrder=false, so no order is ever authorized. Flip to `live` only after
# check_live_readiness passes on real dry-run history AND a human decides to.
# -----------------------------------------------------------------------------
MODE=dry-run

# -----------------------------------------------------------------------------
# HTTP transport (src/mcp/server.ts). The persistent Claude session hits this
# over a stable URL each cycle, authenticating with MCP_AUTH_TOKEN.
# -----------------------------------------------------------------------------
MCP_HTTP_PORT=8787

# >>> REQUIRED: shared bearer secret the calling session must present. Generate
# a fresh one and keep it out of source control / chat logs:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Docker port-publish interface (docker-compose.yml). Pick ONE model:
#   - Behind NAT (home/office): leave BLANK and use the Cloudflare tunnel
#     profile (`docker compose --profile tunnel up`) — it reaches the `mcp`
#     service over the compose network, so no published port is needed.
#   - Host has its own public IP/hostname: set 0.0.0.0 (still gated by
#     MCP_AUTH_TOKEN) and skip the tunnel.
MCP_PUBLISH_BIND=

# Only used with `docker compose --profile tunnel up` (host behind NAT). Paste
# the Cloudflare tunnel token here; see README "Docker" → tunnel. Leave blank
# for a host that already has its own reachable address.
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Persisted state — safety/halt flag, PDT trade log, learned weights, audit log.
# These are the Docker volume mount paths; NEVER run without them mounted. A
# lost STATE_DIR silently resets the kill-switch + PDT history (see README).
# -----------------------------------------------------------------------------
STATE_DIR=/app/state
AUDIT_LOG_DIR=/app/runs

# -----------------------------------------------------------------------------
# Risk limits (see src/config/riskLimits.ts for the full, non-.env set). Values
# below are the built-in defaults. Treat DAILY_LOSS_HALT_PCT as a hard stop.
# -----------------------------------------------------------------------------
DAILY_LOSS_HALT_PCT=0.10
MARGIN_UTILIZATION_CAP=0.8
MARGIN_ENABLED=true
PDT_EQUITY_THRESHOLD_USD=25000

# -----------------------------------------------------------------------------
# Sentiment / news providers (src/sentiment). A missing key degrades that input
# to a neutral score rather than blocking the loop — fine for dry-run, but a
# live decision path running blind on sentiment should be a deliberate choice.
# -----------------------------------------------------------------------------
# Finnhub — financial/company headlines. finnhub.io/register
FINNHUB_API_KEY=

# NewsAPI.org — world/political headlines.
# >>> REQUIRED BEFORE MODE=live: the free Developer plan disallows production
# use — get a paid plan or swap the provider (NewsProvider is generic).
NEWSAPI_KEY=

# Benzinga — real-time stock news (paid, optional). benzinga.com/apis
BENZINGA_API_KEY=

# CoinGecko — crypto market data. Free-tier endpoints work with no key; a demo
# key just raises the rate limit.
COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# X (Twitter) — macro news AND per-symbol chatter. Paid Basic tier or above.
# Leave blank to run without the social_chatter / X-macro signals (they degrade
# to neutral). Note: social_chatter is the most manipulable input (README).
# -----------------------------------------------------------------------------
X_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# LLM for sentiment reasoning + learning reflections (OpenAI-compatible).
# IMPORTANT for Docker: `localhost` inside the container is the container
# itself — point this at the host or the gateway's real address:
#   - Docker Desktop:  http://host.docker.internal:3001/v1
#   - Plain Linux:     the gateway's reachable host/IP
# (The freellmapi server in this monorepo serves on :3001 by default.)
# A failed/invalid LLM response degrades to a neutral score, never blocks.
# -----------------------------------------------------------------------------
LLM_GATEWAY_URL=http://host.docker.internal:3001/v1
# >>> REQUIRED: your freellmapi unified key (or the provider key directly).
# Keep this value empty until filled — a whitespace value parses as a
# non-empty (truthy) key and would trigger authenticated calls with a bad key.
LLM_GATEWAY_API_KEY=
SENTIMENT_MODEL=gpt-4o-mini
