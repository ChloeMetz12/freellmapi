{
  "name": "salesforce-gantt-agent",
  "version": "0.1.0",
  "description": "On-demand agent that adds a project to Salesforce Field Service's Classic Dispatch Console (Gantt schedule) via browser automation, invoked by name from a chat with Claude.",
  "private": true,
  "type": "module",
  "bin": {
    "salesforce-gantt-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "login": "tsx src/auth/login.ts",
    "login:assisted:start": "tsx scripts/start-assisted-login.ts",
    "login:assisted:action": "tsx scripts/login-action.ts",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.1.3"
  }
}
