# Salesforce org login URL, e.g. https://your-domain.my.salesforce.com
SF_ORG_URL=

# Where the Playwright auth session (storageState) is written/read.
# Created by `npm run login`. Never commit this file.
SF_AUTH_STATE_PATH=./auth/storageState.json

# Your Salesforce display name, exactly as it appears in Salesforce (e.g.
# "Andrew Metz"). Used as the Work Order's Owner and Dispatcher, since the
# training transcript has the person running the tool set themselves as both.
SF_USER_DISPLAY_NAME=

# Run mode: "dry-run" (default, no live Salesforce mutations) or "live".
MODE=dry-run

# Escalation email — sent only to you when a project needs manual
# technician assignment (Get Candidates failed/returned nothing).
ESCALATION_EMAIL_TO=
ESCALATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Virtual display (Xvfb) size — Salesforce restricts headless sessions,
# so every run launches a headed browser against a virtual framebuffer.
VIRTUAL_DISPLAY_WIDTH=1440
VIRTUAL_DISPLAY_HEIGHT=900
